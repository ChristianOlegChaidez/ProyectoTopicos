@model ProyectoTopicos.Models.Ayudantias_Investigacion

@{
    ViewData["Title"] = "Agregar Ayudantía";
}

<style>
    .uabc-header {
        background-color: #1a5c2a;
        color: white;
        padding: 20px 30px;
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
        border-radius: 8px;
    }

        .uabc-header h1 {
            font-size: 2rem;
            margin: 0;
        }

    .autocomplete-wrapper {
        position: relative;
    }

    .autocomplete-list {
        position: absolute;
        z-index: 999;
        background: white;
        border: 1px solid #ccc;
        border-radius: 4px;
        width: 100%;
        max-height: 200px;
        overflow-y: auto;
        display: none;
    }

        .autocomplete-list div {
            padding: 8px 12px;
            cursor: pointer;
        }

            .autocomplete-list div:hover {
                background-color: #f0f0f0;
            }
</style>

<div class="uabc-header">
    <h1>Agregar Ayudantía de Investigación</h1>
</div>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label>Clave Ayudantía</label>
                <input asp-for="Clave_Ayudantias" class="form-control" placeholder="Ej. 1001" />
                <span asp-validation-for="Clave_Ayudantias" class="text-danger"></span>
            </div>

            <h5 class="mt-3">Datos del Alumno</h5>

            <div class="form-group autocomplete-wrapper">
                <label>Matrícula</label>
                <input id="buscarAlumno" class="form-control" placeholder="Escribe matrícula o nombre..." autocomplete="off" />
                <div class="autocomplete-list" id="listaAlumnos"></div>
                <input asp-for="Matricula" type="hidden" id="Matricula" />
            </div>
            <div class="form-group">
                <label>Nombre Alumno</label>
                <input asp-for="Nombre_Alumno" class="form-control" id="Nombre_Alumno" readonly />
            </div>

            <h5 class="mt-3">Datos de la Materia</h5>

            <div class="form-group autocomplete-wrapper">
                <label>Nombre de Ayudantía</label>
                <input id="buscarMateria" class="form-control" placeholder="Escribe nombre de materia..." autocomplete="off" />
                <div class="autocomplete-list" id="listaMaterias"></div>
                <input asp-for="Nombre_de_Ayudantia" type="hidden" id="Nombre_de_Ayudantia" />
            </div>
            <div class="form-group">
                <label>Programa Educativo</label>
                <input asp-for="Programa_Educativo" class="form-control" id="Programa_Educativo" readonly />
            </div>
            <div class="form-group">
                <label>No. Programa Educativo</label>
                <input asp-for="No_Programa_Educativo" class="form-control" id="No_Programa_Educativo" readonly />
            </div>
            <div class="form-group">
                <label>Plan de Estudios</label>
                <input asp-for="Plan_Estudios" class="form-control" id="Plan_Estudios" readonly />
            </div>
            <div class="form-group">
                <label>Créditos</label>
                <input asp-for="Creditos_de_Ayudantia" class="form-control" id="Creditos_de_Ayudantia" readonly />
            </div>

            <h5 class="mt-3">Datos del Maestro</h5>

            <div class="form-group autocomplete-wrapper">
                <label>No. de Empleado</label>
                <input id="buscarMaestro" class="form-control" placeholder="Escribe número o nombre..." autocomplete="off" />
                <div class="autocomplete-list" id="listaMaestros"></div>
                <input asp-for="No_de_Empleado" type="hidden" id="No_de_Empleado" />
            </div>
            <div class="form-group">
                <label>Nombre Empleado</label>
                <input asp-for="Nombre_Empleado" class="form-control" id="Nombre_Empleado" readonly />
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Guardar" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const alumnos = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Alumnos));
        const maestros = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Maestros));
        const materias = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Materias));

        function autocomplete(inputId, listId, data, searchFields, onSelect) {
            const input = document.getElementById(inputId);
            const list = document.getElementById(listId);
            input.addEventListener('input', function () {
                const q = this.value.toLowerCase();
                list.innerHTML = '';
                if (!q) { list.style.display = 'none'; return; }
                const filtered = data.filter(d => searchFields.some(f => String(d[f]).toLowerCase().includes(q)));
                if (filtered.length === 0) { list.style.display = 'none'; return; }
                filtered.forEach(item => {
                    const div = document.createElement('div');
                    div.textContent = searchFields.map(f => item[f]).join(' - ');
                    div.addEventListener('click', () => {
                        input.value = div.textContent;
                        list.style.display = 'none';
                        onSelect(item);
                    });
                    list.appendChild(div);
                });
                list.style.display = 'block';
            });
            document.addEventListener('click', e => { if (!input.contains(e.target)) list.style.display = 'none'; });
        }

        autocomplete('buscarAlumno', 'listaAlumnos', alumnos, ['Matricula', 'Nombre'], item => {
            document.getElementById('Matricula').value = item.Matricula;
            document.getElementById('Nombre_Alumno').value = item.Nombre;
        });

        autocomplete('buscarMateria', 'listaMaterias', materias, ['NombreUA', 'NombrePE'], item => {
            document.getElementById('Nombre_de_Ayudantia').value = item.NombreUA;
            document.getElementById('Programa_Educativo').value = item.NombrePE;
            document.getElementById('No_Programa_Educativo').value = item.NoPE;
            document.getElementById('Plan_Estudios').value = item.PlanDeEstudios;
            document.getElementById('Creditos_de_Ayudantia').value = item.Creditos;
        });

        autocomplete('buscarMaestro', 'listaMaestros', maestros, ['Numero_Empleado', 'Nombre'], item => {
            document.getElementById('No_de_Empleado').value = item.Numero_Empleado;
            document.getElementById('Nombre_Empleado').value = item.Nombre;
        });
    </script>
}