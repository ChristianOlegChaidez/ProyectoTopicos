@model ProyectoTopicos.Models.EstudiosIndependientes

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>
<h4>EstudiosIndependientes</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="No" class="control-label"></label>
                <input asp-for="No" class="form-control" />
                <span asp-validation-for="No" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="No_Programa_Educativo" class="control-label"></label>
                <input asp-for="No_Programa_Educativo" class="form-control" />
                <span asp-validation-for="No_Programa_Educativo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Programa_Educativo" class="control-label"></label>
                <input asp-for="Programa_Educativo" class="form-control" />
                <span asp-validation-for="Programa_Educativo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Plan_de_Estudios" class="control-label"></label>
                <input asp-for="Plan_de_Estudios" class="form-control" />
                <span asp-validation-for="Plan_de_Estudios" class="text-danger"></span>
            </div>

            <!-- Matrícula con Select2 -->
            <div class="form-group">
                <label asp-for="Matricula" class="control-label"></label>
                <select asp-for="Matricula" class="form-control" id="Matricula">
                    <option value="">-- Selecciona alumno --</option>
                    @foreach (var a in ViewBag.Alumnos)
                    {
                        <option value="@a.Matricula">@a.Matricula - @a.Nombre</option>
                    }
                </select>
                <span asp-validation-for="Matricula" class="text-danger"></span>
            </div>

            <!-- Nombre Alumno (se llena solo) -->
            <div class="form-group">
                <label asp-for="Nombre_Alumno" class="control-label"></label>
                <input asp-for="Nombre_Alumno" class="form-control" id="Nombre_Alumno"
                       readonly style="background:#f0f0f0;" placeholder="Se llena automáticamente..." />
            </div>

            <div class="form-group">
                <label asp-for="Nombre_Estudio_Independiente" class="control-label"></label>
                <input asp-for="Nombre_Estudio_Independiente" class="form-control" />
                <span asp-validation-for="Nombre_Estudio_Independiente" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Creditos_Estudio_Independiente" class="control-label"></label>
                <input asp-for="Creditos_Estudio_Independiente" class="form-control" />
                <span asp-validation-for="Creditos_Estudio_Independiente" class="text-danger"></span>
            </div>

            <!-- No. Empleado con Select2 -->
            <div class="form-group">
                <label asp-for="No_Empleado" class="control-label"></label>
                <select asp-for="No_Empleado" class="form-control" id="No_Empleado">
                    <option value="">-- Selecciona maestro --</option>
                    @foreach (var m in ViewBag.Maestros)
                    {
                        <option value="@m.Numero_Empleado">@m.Numero_Empleado - @m.Nombre</option>
                    }
                </select>
                <span asp-validation-for="No_Empleado" class="text-danger"></span>
            </div>

            <!-- Materia con Select2 -->
            <div class="form-group">
                <label asp-for="Nombre_Estudio_Independiente" class="control-label"></label>
                <select class="form-control" id="SelectMateria">
                    <option value="">-- Selecciona materia --</option>
                    @foreach (var m in ViewBag.Materias)
                    {
                        <option value="@m.ClaveUA"
                                data-nombre="@m.NombreUA"
                                data-pe="@m.NombrePE"
                                data-plan="@m.PlanDeEstudios"
                                data-creditos="@m.Creditos"
                                data-nope="@m.NoPE">
                            @m.NombreUA - @m.NombrePE
                        </option>
                    }
                </select>
            </div>

            <!-- Campos que se llenan solos -->
            <input type="hidden" asp-for="Nombre_Estudio_Independiente" id="Nombre_Estudio_Independiente" />

            <!-- Nombre Profesor (se llena solo) -->
            <div class="form-group">
                <label asp-for="Nombre_Profesor_Tutor_Investigar" class="control-label"></label>
                <input asp-for="Nombre_Profesor_Tutor_Investigar" class="form-control" id="Nombre_Profesor_Tutor_Investigar"
                       readonly style="background:#f0f0f0;" placeholder="Se llena automáticamente..." />
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

<input asp-for="Programa_Educativo" class="form-control" id="Programa_Educativo" readonly style="background:#f0f0f0;" />
<input asp-for="Plan_de_Estudios" class="form-control" id="Plan_de_Estudios" readonly style="background:#f0f0f0;" />
<input asp-for="No_Programa_Educativo" class="form-control" id="No_Programa_Educativo" readonly style="background:#f0f0f0;" />
<input asp-for="Creditos_Estudio_Independiente" class="form-control" id="Creditos_Estudio_Independiente" readonly style="background:#f0f0f0;" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {

        // Activa Select2 en Matrícula
        $('#Matricula').select2({
        placeholder: "Busca por matrícula o nombre...",
        allowClear: true,
        width: '100%'
        });

        // Activa Select2 en No. Empleado
        $('#No_Empleado').select2({
        placeholder: "Busca por no. empleado o nombre...",
        allowClear: true,
        width: '100%'
        });

        // Al seleccionar alumno → llena nombre automáticamente
        $('#Matricula').on('change', function () {
        var texto = $(this).find('option:selected').text();
        if (texto && texto !== '-- Selecciona alumno --') {
        var partes = texto.split(' - ');
        var nombre = partes.slice(1).join(' - '); // por si el nombre tiene guiones
        $('#Nombre_Alumno').val(nombre);
        } else {
        $('#Nombre_Alumno').val('');
        }
        });

        $('#SelectMateria').select2({
    placeholder: "Busca materia...",
    allowClear: true,
    width: '100%'
});

$('#SelectMateria').on('change', function () {
    var op = $(this).find('option:selected');
    $('#Nombre_Estudio_Independiente').val(op.data('nombre'));
    $('#Programa_Educativo').val(op.data('pe'));
    $('#Plan_de_Estudios').val(op.data('plan'));
    $('#Creditos_Estudio_Independiente').val(op.data('creditos'));
    $('#No_Programa_Educativo').val(op.data('nope'));
});

        // Al seleccionar maestro → llena nombre automáticamente
        $('#No_Empleado').on('change', function () {
        var texto = $(this).find('option:selected').text();
        if (texto && texto !== '-- Selecciona maestro --') {
        var partes = texto.split(' - ');
        var nombre = partes.slice(1).join(' - ');
        $('#Nombre_Profesor_Tutor_Investigar').val(nombre);
        } else {
        $('#Nombre_Profesor_Tutor_Investigar').val('');
        }
        });

        });
    </script>
}
