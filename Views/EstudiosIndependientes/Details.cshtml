@model ProyectoTopicos.Models.EstudiosIndependientes

@{
    ViewData["Title"] = "Detalles del Estudio Independiente";
}

<div class="container mt-4">
    <div class="d-flex align-items-center justify-content-between p-3 text-white rounded mb-4 shadow-sm" style="background-color: #1a5c37;">
        <div class="d-flex align-items-center">
            <div class="me-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 50px;">
                <img src="~/images/LOGOUABC.png" alt="UABC" style="max-height: 100%; max-width: 100%; object-fit: contain;" onerror="this.parentElement.style.display='none'" />
            </div>
            <h2 class="m-0 font-weight-bold" style="font-size: 1.6rem; letter-spacing: 0.5px;">Información Detallada</h2>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-lg">
        <div class="card-body p-4">
            <table class="table table-striped table-bordered m-0">
                <tbody>
                    <tr>
                        <th style="width: 30%; background-color: #f8f9fa;">@Html.DisplayNameFor(model => model.No)</th>
                        <td>@Html.DisplayFor(model => model.No)</td>
                    </tr>
                    <tr>
                        <th style="background-color: #f8f9fa;">@Html.DisplayNameFor(model => model.No_Programa_Educativo)</th>
                        <td>@Html.DisplayFor(model => model.No_Programa_Educativo)</td>
                    </tr>
                    <tr>
                        <th style="background-color: #f8f9fa;">@Html.DisplayNameFor(model => model.Programa_Educativo)</th>
                        <td>@Html.DisplayFor(model => model.Programa_Educativo)</td>
                    </tr>
                    <tr>
                        <th style="background-color: #f8f9fa;">@Html.DisplayNameFor(model => model.Plan_de_Estudios)</th>
                        <td>@Html.DisplayFor(model => model.Plan_de_Estudios)</td>
                    </tr>
                    <tr>
                        <th style="background-color: #f8f9fa;">@Html.DisplayNameFor(model => model.Matricula)</th>
                        <td>@Html.DisplayFor(model => model.Matricula)</td>
                    </tr>
                    <tr>
                        <th style="background-color: #f8f9fa;">@Html.DisplayNameFor(model => model.Nombre_Alumno)</th>
                        <td>@Html.DisplayFor(model => model.Nombre_Alumno)</td>
                    </tr>
                    <tr>
                        <th style="background-color: #f8f9fa;">@Html.DisplayNameFor(model => model.Nombre_Estudio_Independiente)</th>
                        <td>@Html.DisplayFor(model => model.Nombre_Estudio_Independiente)</td>
                    </tr>
                    <tr>
                        <th style="background-color: #f8f9fa;">@Html.DisplayNameFor(model => model.Creditos_Estudio_Independiente)</th>
                        <td>@Html.DisplayFor(model => model.Creditos_Estudio_Independiente)</td>
                    </tr>
                    <tr>
                        <th style="background-color: #f8f9fa;">@Html.DisplayNameFor(model => model.No_Empleado)</th>
                        <td>@Html.DisplayFor(model => model.No_Empleado)</td>
                    </tr>
                    <tr>
                        <th style="background-color: #f8f9fa;">@Html.DisplayNameFor(model => model.Nombre_Profesor_Tutor_Investigar)</th>
                        <td>@Html.DisplayFor(model => model.Nombre_Profesor_Tutor_Investigar)</td>
                    </tr>
                </tbody>
            </table>

            <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-4">
                <a asp-action="Index" class="btn btn-secondary px-4 rounded-pill me-2">Regresar al Listado</a>
                <a asp-action="Edit" asp-route-id="@Model?.Clave_Estudio_Independiente" class="btn text-white px-4 rounded-pill shadow-sm" style="background-color: #1a5c37;">Modificar Registro</a>
            </div>
        </div>
    </div>
</div>