@model ProyectoTopicos.Models.UnidadAprendizajeAsesoria

@{
    ViewData["Title"] = "Agregar";
}

<style>
    .header-bar { background: #1a5c2e; color: white; padding: 1.2rem 2rem; border-radius: 8px 8px 0 0; font-size: 22px; font-weight: 500; }
    .btn-verde { background: #1a5c2e; color: white; border: none; padding: 10px 30px; border-radius: 6px; font-size: 16px; cursor: pointer; }
    .btn-verde:hover { background: #0f3d1e; color: white; }
    .btn-cancelar { background: #888; color: white; border: none; padding: 10px 30px; border-radius: 6px; font-size: 16px; text-decoration: none; }
    .btn-cancelar:hover { background: #555; color: white; }
    .autocomplete-wrap { position: relative; }
    .autocomplete-list { position: absolute; z-index: 999; background: white; border: 1px solid #ccc; border-radius: 6px; width: 100%; max-height: 200px; overflow-y: auto; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
    .autocomplete-list div { padding: 8px 12px; cursor: pointer; font-size: 14px; }
    .autocomplete-list div:hover { background: #f0fff0; }
    .campo-auto { background: #white; }
</style>

<div style="border: 1.5px solid #bbb; border-radius: 10px; overflow: hidden; max-width: 700px; margin: auto;">
    <div class="header-bar" style="display: flex; align-items: center; gap: 20px;">
    <img src="~/images/logo-uabc.png" alt="Logo UABC" style="height: 60px;" />
    <span>Agregar Registro</span>
</div>
    <div style="padding: 1.5rem; background: white;">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- 1. No -->
            <div class="mb-3">
                <label asp-for="No" class="form-label"></label>
                <input asp-for="No" class="form-control" />
                <span asp-validation-for="No" class="text-danger"></span>
            </div>

            <div class="mb-3">
             <label asp-for="No_de_programa_Educativo" class="form-label"></label>
            <input asp-for="No_de_programa_Educativo" class="form-control campo-auto" id="noProgramaEducativo" />
            <span asp-validation-for="No_de_programa_Educativo" class="text-danger"></span>
            </div>

            <div class="mb-3">
            <label asp-for="Programa_Educativo" class="form-label"></label>
            <input asp-for="Programa_Educativo" class="form-control campo-auto" id="programaEducativo" />
            <span asp-validation-for="Programa_Educativo" class="text-danger"></span>
            </div>

            <div class="mb-3">
            <label asp-for="Plan_de_estudios" class="form-label"></label>
            <input asp-for="Plan_de_estudios" class="form-control campo-auto" id="planEstudios" />
            <span asp-validation-for="Plan_de_estudios" class="text-danger"></span>
            </div>

            <!-- 5. Matricula del Alumno -->
            <div class="mb-3 autocomplete-wrap">
            <label asp-for="Matricula_del_Alumno" class="form-label"></label>
            <input asp-for="Matricula_del_Alumno" class="form-control" id="matricula" autocomplete="off" />
            <span asp-validation-for="Matricula_del_Alumno" class="text-danger"></span>
            <div class="autocomplete-list" id="listaAlumnosMatricula" style="display:none;"></div>

            </div>
            <!-- 6. Nombre del Alumno (autocompletado al escribir) -->
            <div class="mb-3 autocomplete-wrap">
                <label asp-for="Nombre_del_Alumno" class="form-label"></label>
                <input asp-for="Nombre_del_Alumno" class="form-control campo-auto" id="nombreAlumno" autocomplete="off" />
                <span asp-validation-for="Nombre_del_Alumno" class="text-danger"></span>
                <div class="autocomplete-list" id="listaAlumnos" style="display:none;"></div>
            </div>

            <!-- 7. Clave de la materia -->
            <div class="mb-3">
                <label asp-for="Clave_de_la_materia" class="form-label"></label>
                <input asp-for="Clave_de_la_materia" class="form-control" id="claveMateria" />
                <span asp-validation-for="Clave_de_la_materia" class="text-danger"></span>
            </div>

            <!-- 8. Nombre de la Unidad de Aprendizaje (autocompletado al escribir) -->
            <div class="mb-3 autocomplete-wrap">
                <label asp-for="Nombre_de_la_Unidad_de_Aprendizaje_por_asesoria_Academica" class="form-label"></label>
                <input asp-for="Nombre_de_la_Unidad_de_Aprendizaje_por_asesoria_Academica" class="form-control campo-auto" id="nombreMateria" autocomplete="off" />
                <span asp-validation-for="Nombre_de_la_Unidad_de_Aprendizaje_por_asesoria_Academica" class="text-danger"></span>
                <div class="autocomplete-list" id="listaMaterias" style="display:none;"></div>
            </div>

            <!-- 9. Creditos -->
            <div class="mb-3">
                <label asp-for="Creditos_de_la_Unidad_de_Aprendizaje" class="form-label"></label>
                <input asp-for="Creditos_de_la_Unidad_de_Aprendizaje" class="form-control campo-auto" id="creditos" />
                <span asp-validation-for="Creditos_de_la_Unidad_de_Aprendizaje" class="text-danger"></span>
            </div>

            <!-- 10. No. de empleado -->
            <div class="mb-3">
                <label asp-for="No_de_empleado" class="form-label"></label>
                <input asp-for="No_de_empleado" class="form-control" id="noEmpleado" />
                <span asp-validation-for="No_de_empleado" class="text-danger"></span>
            </div>

            <!-- 11. Nombre del profesor (autocompletado al escribir) -->
            <div class="mb-3 autocomplete-wrap">
                <label asp-for="Nombre_del_profesor" class="form-label"></label>
                <input asp-for="Nombre_del_profesor" class="form-control campo-auto" id="nombreProfesor" autocomplete="off" />
                <span asp-validation-for="Nombre_del_profesor" class="text-danger"></span>
                <div class="autocomplete-list" id="listaMaestros" style="display:none;"></div>
            </div>

            <!-- 12. Grupo -->
            <div class="mb-3">
                <label asp-for="Grupo" class="form-label"></label>
                <input asp-for="Grupo" class="form-control" />
                 <span asp-validation-for="Grupo" class="text-danger"></span>
            </div>

            <!-- 13. CAPTURADO -->
<div class="mb-3">
    <label asp-for="CAPTURADO" class="form-label"></label>
    <input type="checkbox" name="CAPTURADO" value="true" />
    <input type="hidden" name="CAPTURADO" value="false" />
</div>

            <div style="display: flex; gap: 12px; margin-top: 1.5rem;">
                <button type="submit" class="btn-verde">Guardar</button>
                <a asp-action="Index" class="btn-cancelar">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<script>
    function autocomplete(inputId, listaId, url, onSelect) {
        const input = document.getElementById(inputId);
        const lista = document.getElementById(listaId);

        input.addEventListener('input', async function () {
            const q = this.value;
            if (q.length < 2) { lista.style.display = 'none'; return; }
            const res = await fetch(`${url}${encodeURIComponent(q)}`);
            if (!res.ok) { lista.style.display = 'none'; return; }
            const data = await res.json();
            lista.innerHTML = '';
            if (data.length === 0) { lista.style.display = 'none'; return; }
            data.forEach(item => {
                const div = document.createElement('div');
                div.textContent = onSelect.label(item);
                div.addEventListener('click', () => {
                    input.value = onSelect.label(item);
                    onSelect.fill(item);
                    lista.style.display = 'none';
                });
                lista.appendChild(div);
            });
            lista.style.display = 'block';
        });

        document.addEventListener('click', e => {
            if (!input.contains(e.target)) lista.style.display = 'none';
        });
    }

    // Nombre del alumno → autocompleta matrícula
    autocomplete('nombreAlumno', 'listaAlumnos',
        '/UnidadAprendizajeAsesoria/BuscarAlumno?nombre=',
        {
            label: item => item.nombre,
            fill: item => {
                document.getElementById('matricula').value = item.matricula;
            }
        }
    );

    autocomplete('matricula', 'listaAlumnosMatricula',
    '/UnidadAprendizajeAsesoria/BuscarAlumno?nombre=',
    {
        label: item => item.matricula + ' - ' + item.nombre,
        fill: item => {
            document.getElementById('matricula').value = item.matricula;
            document.getElementById('nombreAlumno').value = item.nombre;
        }
    }
);

    // Nombre de la materia → autocompleta clave y créditos
    autocomplete('nombreMateria', 'listaMaterias',
    '/UnidadAprendizajeAsesoria/BuscarMateria?nombre=',
    {
        label: item => item.nombreUA,
        fill: item => {
            document.getElementById('claveMateria').value = item.claveUA;
            document.getElementById('creditos').value = item.creditos ?? '';
            document.getElementById('noProgramaEducativo').value = item.noPE ?? '';
            document.getElementById('programaEducativo').value = item.nombrePE ?? '';
            document.getElementById('planEstudios').value = item.planDeEstudios ?? '';
        }
    }
);

    // Nombre del profesor → autocompleta no de empleado
    autocomplete('nombreProfesor', 'listaMaestros',
        '/UnidadAprendizajeAsesoria/BuscarMaestro?nombre=',
        {
            label: item => item.nombre,
            fill: item => {
                document.getElementById('noEmpleado').value = item.numero_Empleado;
            }
        }
    );
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}